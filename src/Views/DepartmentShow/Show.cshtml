@* クラスの名前空間を指定する(C#と同じ) *@
@using csharp_training_202605.Presentations.ViewModels
@* View が受け取るデータ型（ViewModel）を宣言asp-for はこの型のプロパティと結びつける *@
@model List<DepartmentShowViewModel>
@{
    ViewData["Title"] = "部署一覧";
}
<h2 class="text-center mt-4">@ViewData["Title"]</h2>

<div class="d-flex justify-content-center mt-5">
    <table class="table table-bordered w-auto">
        <thead class="table-light">
            <tr>
                <th>部署ID</th>
                <th>部署名</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var department in Model.OrderBy(d => d.Id))
            {
                <tr>
                    <td>@department.Id</td>
                    <td>@department.Name</td>
                    <td>
                        <!-- 行ごとにフォームを作成し、POSTでオブジェクトを送信 -->
                        <form asp-controller="DepartmentDelete" asp-action="Confirm" method="post" class="d-inline">
                            <input type="hidden" name="Id" value="@department.Id" />
                            <input type="hidden" name="Name" value="@department.Name" />

                            <button type="submit" class="btn btn-secondary">削除</button>
                        </form>
                    </td>
                    <td>
                        <!-- 行ごとにフォームを作成し、POSTでオブジェクトを送信 -->
                        <form asp-controller="DepartmentUpdate" asp-action="Enter" method="post" class="d-inline">
                            <input type="hidden" name="Id" value="@department.Id" />
                            <input type="hidden" name="Name" value="@department.Name" />

                            <button type="submit" class="btn btn-danger">更新</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@* 新規追加ボタン *@
<div class="d-flex justify-content-center gap-3 my-4">
    <a asp-controller="DepartmentRegister" asp-action="Enter" class="btn btn-success">新規部署の追加</a>
</div>