@using csharp_training_202605.Presentations.ViewModels
@model DepartmentDeleteViewModel;
@{
    ViewData["Title"] = "部署削除(完了)";
}
<h2 class="text-center mt-4">@ViewData["Title"]</h2>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-sm-8 text-center">
            <div class="alert alert-success" role="alert">
                部署の削除が完了しました。
            </div>
            <table class="table table-hover">
                <tbody>
                    @*削除した部署と所属部署を表示する*@
                    <tr>
                        <td class="fw-bold">@Html.DisplayNameFor(m => m.Name)</td>
                        <td>@Html.DisplayFor(m => m.Name)</td>
                    </tr>
                </tbody>
            </table>
            @*メニューに戻る*@
            <a asp-action="Show" asp-controller="DepartmentShow" class="btn btn-secondary mt-3 ms-2">
                部署一覧に戻る
            </a>
        </div>
    </div>
</div>