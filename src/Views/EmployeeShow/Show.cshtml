@* クラスの名前空間を指定する(C#と同じ) *@
@using csharp_training_202605.Presentations.ViewModels
@* View が受け取るデータ型（ViewModel）を宣言asp-for はこの型のプロパティと結びつける *@
@model List<EmployeeShowViewModel>
@{
    ViewData["Title"] = "従業員一覧";
}
<h2 class="text-center mt-4">@ViewData["Title"]</h2>

<div class="d-flex justify-content-center mt-5">
    <table class="table table-bordered w-auto">
        <thead class="table-light">
            <tr>
                <th>社員ID</th>
                <th>氏名</th>
                <th>メールアドレス</th>
                <th>電話番号</th>
                <th>部署</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model.OrderBy(e => e.Id))
            {
                <tr>
                    <td>@employee.Id</td>
                    <td>@employee.Name</td>
                    <td>@employee.Email</td>
                    <td>@employee.Phone</td>
                    <td>@employee.DeptName</td>
                    <td>
                        <!-- 行ごとにフォームを作成し、POSTでオブジェクトを送信 -->
                        <form asp-controller="EmployeeDelete" asp-action="Confirm" method="post" class="d-inline">
                            <input type="hidden" name="Id" value="@employee.Id" />
                            <input type="hidden" name="Name" value="@employee.Name" />
                            <input type="hidden" name="Email" value="@employee.Email" />
                            <input type="hidden" name="Phone" value="@employee.Phone" />
                            <input type="hidden" name="DeptName" value="@employee.DeptName" />

                            <button type="submit" class="btn btn-secondary">削除</button>
                        </form>
                    </td>
                    <td>
                        <!-- 行ごとにフォームを作成し、POSTでオブジェクトを送信 -->
                        <form asp-controller="EmployeeUpdate" asp-action="Enter" method="post" class="d-inline">
                            <input type="hidden" name="Id" value="@employee.Id" />
                            <input type="hidden" name="Name" value="@employee.Name" />
                            <input type="hidden" name="Email" value="@employee.Email" />
                            <input type="hidden" name="Phone" value="@employee.Phone" />
                            <input type="hidden" name="DeptId" value="@employee.DeptId" />
                            <input type="hidden" name="DeptName" value="@employee.DeptName" />

                            <button type="submit" class="btn btn-danger">更新</button>
                        </form>

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@* 新規追加ボタン *@
<div class="d-flex justify-content-center gap-3 my-4">
    <a asp-controller="EmployeeRegister" asp-action="Enter" class="btn btn-primary">新規従業員の追加</a>
</div>